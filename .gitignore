# ==========================================
# LeptoWatch — Git Ignore Rules
# Strictly prevents data, secrets & build artifacts
# ==========================================

# Secrets and environment files
.env
.env.local
.env.*.local
*.pem
*.key
*.token
credentials.json
client_secrets.json

# Dependencies
node_modules/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.tox/
.venv/
env/
venv/
ENV/

# Build and runtime outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Large Data & Binary Files (Strictly Excluded)
data/
*.parquet
*.parquet.*
*.pkl
*.joblib
*.gpkg
*.sqlite
*.sqlite3
*.db
*.csv
!HANDOVER_MANIFEST.csv
!packages/leptowatch/sample_data/*.csv
*.tar
*.tar.gz
*.zip
*.7z
*.rar

# Model weights and ledger
models/*.pkl
models/*.joblib
ledger/
*.bin

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
