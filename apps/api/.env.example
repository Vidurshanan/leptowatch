# LeptoWatch API Configuration
# Root path to the LeptoWatch repository (defaults to project root relative to apps/api)
LEPTOWATCH_ROOT=../..

# Server binding
LEPTOWATCH_HOST=0.0.0.0
LEPTOWATCH_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Policy parameters
FRESHNESS_POLICY_DAYS=56
